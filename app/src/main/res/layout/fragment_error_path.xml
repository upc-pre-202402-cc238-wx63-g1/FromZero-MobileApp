<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    tools:context=".UI.fragments.ErrorPathFragment">

    <!-- TODO: Update blank fragment layout -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:gravity="center_horizontal"
        android:text="@string/ups_parece_que_ocurrio_un_error"
        android:textAllCaps="false"
        android:textColor="@color/primary_title_color"
        android:textSize="30sp"
        android:textStyle="bold" />

    <ImageView
        android:id="@+id/imageView7"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_cancelmark_purple"
        android:layout_marginTop="140dp"
        android:layout_gravity="center_horizontal"/>

    <ImageView
        android:id="@+id/imageView8"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="70dp"
        android:layout_gravity="center"
        android:src="@drawable/wrong_person_path" />

    <Button
        android:id="@+id/btn_volver"
        android:layout_width="300dp"
        android:layout_height="68dp"
        android:layout_gravity="center"
        android:layout_marginTop="270dp"
        android:layout_weight="1"
        android:backgroundTint="@color/white"
        android:text="@string/Volver"

        android:textColor="@color/primary_title_color"
        android:textSize="32sp"
        android:textStyle="bold"
        app:cornerRadius="25sp"
        app:strokeColor="@color/primary_title_color"
        app:strokeWidth="2sp" />

</FrameLayout>