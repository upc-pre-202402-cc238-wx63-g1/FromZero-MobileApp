<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".UI.fragments.HappyPathFragment">

    <!-- TODO: Update blank fragment layout -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:layout_marginTop="40dp"
        android:text="@string/acci_n_realizada_con_xito"
        android:textColor="@color/Cyan"
        android:textSize="28sp"
        android:textStyle="bold" />

    <ImageView
        android:id="@+id/imageView5"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/ic_checkmark_green"
        android:layout_marginTop="100dp"
        android:layout_gravity="center_horizontal"/>

    <ImageView
        android:id="@+id/imageView6"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="70dp"
        android:layout_gravity="center"
        android:src="@drawable/happy_person_path" />

    <Button
        android:id="@+id/btn_accept"
        android:layout_width="300dp"
        android:layout_height="68dp"
        android:layout_gravity="center"
        android:layout_marginTop="300dp"
        android:layout_weight="1"
        android:backgroundTint="@color/white"
        android:text="@string/aceptar"


        android:textColor="@color/Cyan"
        android:textSize="32sp"
        android:textStyle="bold"
        app:cornerRadius="25sp"
        app:strokeColor="@color/Cyan"
        app:strokeWidth="2sp" />

</FrameLayout>